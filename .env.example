# ── Bienenhaus Propiedades ── Variables de entorno ─────────────────────
# Copiar a .env y completar con valores reales.
#  $ cp .env.example .env

# ── Base de datos ─────────────────────────────────────────────────────
# PostgreSQL local (app.py usa _default_db_url() si no se setea):
#   postgresql://postgres:postgres@localhost:5432/bienenhaus
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bienenhaus

# URL pública del sitio (OG tags, sitemap, CORS, CSP)
SITE_URL=http://localhost:5000

# Clave secreta para firmar cookies de sesión
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-segura

# Contraseña de administrador (opcional — sobreescribe DB)
# ADMIN_PASSWORD=mi_password_seguro

# Tiempo de inactividad admin en segundos (default: 1800 = 30 min)
# INACTIVITY_TIMEOUT=1800

# ── Rate limiting ─────────────────────────────────────────────────────
# Redis opcional (sin Redis usa memoria local — menos preciso en multi-worker)
# REDIS_URL=redis://localhost:6379/0

# ── Cloudinary (imágenes en la nube) ──────────────────────────────────
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Email (SMTP para notificaciones de contacto) ──────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu-contraseña
# EMAIL_FROM=noreply@bienenhaus.com.ar
# EMAIL_TO=admin@bienenhaus.com.ar

# ── Sentry (error tracking) ───────────────────────────────────────────
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────
# Generar: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=BM_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VAPID_CLAIM_EMAIL=admin@bienenhaus.com.ar

# ── Gemini AI (extracción automática de propiedades) ──────────────────
# GEMINI_API_KEY=AIzaSy...

# ── MercadoLibre (portal de publicación) ──────────────────────────────
# ML_CLIENT_ID=1953158870398438
# ML_CLIENT_SECRET=...
# ML_REFRESH_TOKEN=TG-...
# ML_USER_ID=1234567890

# ── ZonaProp / ArgenProp (portal SFTP) ────────────────────────────────
# SFTP_HOST=sftp.zonaprop.com.ar
# SFTP_USER=...
# SFTP_PASS=...

# ── Backups ───────────────────────────────────────────────────────────
# BACKUP_API_KEY=clave-secreta-para-backups-via-api

# ── Portal Worker ─────────────────────────────────────────────────────
# PORTAL_WORKER_AUTO=true   # worker en segundo plano (no recomendado en Render)

# ── Redes Sociales (Marketing) ────────────────────────────────────────
# SOCIAL_WORKER_AUTO=true        # Worker en hilo (no recomendado en Render, usar worker service)
# SOCIAL_WORKER_INTERVAL=60      # Polling en segundos (default: 60)
# META_WEBHOOK_SECRET=mi_secreto # Token de verificación del webhook de Meta

# ── Render (seteado automáticamente por Render) ───────────────────────
# RENDER_EXTERNAL_URL=https://bienenhaus.onrender.com

# Modo debug (true/false)
FLASK_DEBUG=true
